chip soc/intel/alderlake

	# RP1 = M.2 NVMe 1, RP2 = M.2 NVMe 2, RP3 = ASM1166 SATA, RP4 = I226-V LAN1,
	# RP7 = I226-V LAN2, RP9 = PCIe slot (x1 electrical per silkscreen, links x4).
	# Clock source and CLKREQ numbers are the vendor firmware's PcieClkSrcUsage table.
	# ASPM and L1 substates stay off: with them LAN2 dropped its link.
	register "pch_pcie_rp[PCH_RP(1)]" = "{
		.clk_src = 0,
		.clk_req = 0,
		.flags = PCIE_RP_LTR | PCIE_RP_AER,
		.pcie_rp_aspm = ASPM_DISABLE,
		.PcieRpL1Substates = L1_SS_DISABLED,
		.pcie_rp_detect_timeout_ms = 500,
	}"
	# RP2 is a fixed M.2 slot, but without HOTPLUG FSP hides the port when the
	# NVMe drive is not linked yet at its early probe.
	register "pch_pcie_rp[PCH_RP(2)]" = "{
		.clk_src = 1,
		.clk_req = 1,
		.flags = PCIE_RP_LTR | PCIE_RP_AER | PCIE_RP_HOTPLUG,
		.pcie_rp_aspm = ASPM_DISABLE,
		.PcieRpL1Substates = L1_SS_DISABLED,
		.pcie_rp_detect_timeout_ms = 500,
	}"
	register "pch_pcie_rp[PCH_RP(3)]" = "{
		.clk_src = 4,
		.clk_req = 4,
		.flags = PCIE_RP_LTR | PCIE_RP_AER | PCIE_RP_BUILT_IN,
		.pcie_rp_aspm = ASPM_DISABLE,
		.PcieRpL1Substates = L1_SS_DISABLED,
		.pcie_rp_detect_timeout_ms = 500,
	}"
	register "pch_pcie_rp[PCH_RP(4)]" = "{
		.clk_src = 3,
		.clk_req = 3,
		.flags = PCIE_RP_LTR | PCIE_RP_AER | PCIE_RP_BUILT_IN,
		.pcie_rp_aspm = ASPM_DISABLE,
		.PcieRpL1Substates = L1_SS_DISABLED,
		.pcie_rp_detect_timeout_ms = 500,
	}"
	register "pch_pcie_rp[PCH_RP(7)]" = "{
		.clk_src = 5,
		.clk_req = 5,
		.flags = PCIE_RP_LTR | PCIE_RP_AER | PCIE_RP_BUILT_IN,
		.pcie_rp_aspm = ASPM_DISABLE,
		.PcieRpL1Substates = L1_SS_DISABLED,
		.pcie_rp_detect_timeout_ms = 500,
	}"
	# HOTPLUG keeps the port when FSP's early probe misses the card;
	# nas_k_pcie_slot.c then lets the link train.
	register "pch_pcie_rp[PCH_RP(9)]" = "{
		.clk_src = 2,
		.clk_req = 2,
		.flags = PCIE_RP_LTR | PCIE_RP_AER | PCIE_RP_HOTPLUG,
		.pcie_rp_aspm = ASPM_DISABLE,
		.PcieRpL1Substates = L1_SS_DISABLED,
		.pcie_rp_detect_timeout_ms = 500,
	}"

	register "pmc_gpe0_dw0" = "GPP_B"
	register "pmc_gpe0_dw1" = "GPP_D"
	register "pmc_gpe0_dw2" = "GPP_E"

	# ALC897 on SDI0
	register "pch_hda_audio_link_hda_enable" = "true"
	register "pch_hda_sdi_enable[0]" = "true"

	# HDMI/DP audio
	register "pch_hda_idisp_codec_enable" = "true"
	register "pch_hda_idisp_link_frequency" = "HDA_LINKFREQ_96MHZ"
	register "pch_hda_idisp_link_tmode" = "HDA_TMODE_8T"

	# The internal USB-A connector below the top one only carries power.
	register "usb2_ports[0]" = "USB2_PORT_SHORT(OC_SKIP)"	# Rear blue USB 3 (USB 2 pins)
	register "usb2_ports[1]" = "USB2_PORT_SHORT(OC_SKIP)"	# F_USB3.0 channel 1
	register "usb2_ports[2]" = "USB2_PORT_SHORT(OC_SKIP)"	# Rear black
	register "usb2_ports[3]" = "USB2_PORT_SHORT(OC_SKIP)"	# Rear black
	register "usb2_ports[4]" = "USB2_PORT_SHORT(OC_SKIP)"	# SD card reader
	register "usb2_ports[5]" = "USB2_PORT_SHORT(OC_SKIP)"	# Internal USB-A, top
	register "usb2_ports[6]" = "USB2_PORT_SHORT(OC_SKIP)"	# Rear black
	register "usb2_ports[7]" = "USB2_PORT_SHORT(OC_SKIP)"	# F_USB3.0 channel 2 (USB 2 only)

	# All PCH USB 3 lanes are used for PCIe. The SuperSpeed pairs of the rear
	# blue port and F_USB3.0 channel 1 come from TCSS ports 0 and 1, converted
	# to Type-A and paired with PCH USB 2 ports 1 and 2.
	register "tcss_ports[0]" = "TCSS_PORT_DEFAULT(OC_SKIP)"
	register "tcss_ports[1]" = "TCSS_PORT_DEFAULT(OC_SKIP)"
	register "enabletcsscovtypea[0]" = "1"
	register "mappingpchxhciusba[0]" = "1"
	register "enabletcsscovtypea[1]" = "1"
	register "mappingpchxhciusba[1]" = "2"

	register "ddi_ports_config" = "{
		[DDI_PORT_A] = DDI_ENABLE_HPD,
		[DDI_PORT_B] = DDI_ENABLE_HPD | DDI_ENABLE_DDC,
	}"

	device domain 0 on
		device ref igpu on end
		device ref crashlog off end
		device ref xhci on end
		device ref tcss_xhci on
			chip drivers/usb/acpi
				device ref tcss_root_hub on
					chip drivers/usb/acpi
						device ref tcss_usb3_port1 on end	# Rear blue
					end
					chip drivers/usb/acpi
						device ref tcss_usb3_port2 on end	# F_USB3.0 channel 1
					end
				end
			end
		end
		device ref shared_sram on end
		device ref pcie_rp1 on end
		device ref pcie_rp2 on end
		device ref pcie_rp3 on end
		device ref pcie_rp4 on end
		device ref pcie_rp7 on end
		device ref pcie_rp9 on end
		device ref pch_espi on
			register "gen1_dec" = "LPC_IO(0xa00, 0x40)"
			chip superio/ite/it8613e
				register "ec.vin_mask" = "VIN_ALL"
				register "ec.smbus_en" = "1"
				# CPU temperature over PECI, reported relative to TjMax (105 C)
				register "TMPIN1.mode" = "THERMAL_PECI"
				register "TMPIN1.offset" = "105"
				# Vendor setting; the sensor's location and calibration are unknown.
				register "TMPIN2.mode" = "THERMAL_DIODE"
				register "TMPIN2.offset" = "112"
				# tmp_off 0x80 (-128 C): never stop a fan on an invalid reading.
				register "FAN2" = "{	/* CPU_FAN */
					.mode = FAN_SMART_AUTOMATIC,
					.smart = {
						.tmpin     =  1,
						.tmp_off   = 0x80,
						.tmp_start = 45,
						.tmp_full  = 80,
						.tmp_delta =  3,
						.pwm_start = 39,
						.slope     = 30,
						.smoothing =  1,
					},
				}"
				register "FAN3" = "{	/* SYS_FAN */
					.mode = FAN_SMART_AUTOMATIC,
					.smart = {
						.tmpin     =  2,
						.tmp_off   = 0x80,
						.tmp_start = 40,
						.tmp_full  = 60,
						.tmp_delta =  3,
						.pwm_start = 39,
						.slope     = 30,
						.smoothing =  1,
					},
				}"
				device pnp 2e.0 off end
				device pnp 2e.1 off end		# No COM header
				device pnp 2e.4 on		# Environment Controller
					io 0x60 = 0xa30
					io 0x62 = 0xa20
					irq 0x70 = 0x00
					irq 0x71 = 0x80
				end
				device pnp 2e.5 off end		# Keyboard
				device pnp 2e.6 off end		# Mouse
				device pnp 2e.7 on		# GPIO, header signals in Simple I/O
					io 0x60 = 0x000
					io 0x62 = 0xa00
					irq 0x70 = 0x00
				end
				device pnp 2e.a off end		# CIR
			end
		end
		device ref hda on end
		device ref smbus on end
		chip drivers/crb
			device mmio 0xfed40000 on end
		end
	end
end
