# Leave the AMI variable store and backup at BIOS offsets 0x0-0x5ffff unused.
# The vendor runtime variable driver can rewrite that range after a flash;
# place the memory-training cache, FMAP, the UEFI variable store and coreboot
# outside it.
FLASH 0x1000000 {
	SI_DESC@0x0 0x1000
	SI_ME@0x1000 0x413000
	SI_DEVICEEXT2@0x414000 0x1EC000
	BIOS@0x600000 0xa00000 {
		UNUSED@0x0 0x60000
		RW_MRC_CACHE@0x60000 0x10000
		FMAP@0x70000 0x1000
		SMMSTORE@0x80000 0x80000
		COREBOOT(CBFS)@0x100000
	}
}
